# Copie para .env e preencha. O .env nunca vai para o repositório (.gitignore, *.env).
# Change add-gerador-api-deepseek, design D3. Linhas opcionais comentadas: valor
# vazio é recusado na subida (fix-robustez-demo, D3).

# uso ou piloto; obrigatória
DONA_CHECA_MODO=
# obrigatória com gerador deepseek
DEEPSEEK_API_KEY=
# deepseek ou ollama; padrão deepseek em uso e ollama em piloto
# DONA_CHECA_GERADOR=deepseek
# padrão deepseek-v4-pro
# DEEPSEEK_MODELO=deepseek-v4-pro
